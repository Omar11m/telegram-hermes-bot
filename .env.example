# ============================================================
# نموذج لملف الإعدادات - انسخ هذا الملف باسم .env وضع قيمك الخاصة
# ============================================================

# توكن بوت التيليجرام الخاص بك من BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# مفتاح Google Gemini API لمعالجة الرسائل الصوتية
GEMINI_API_KEY="your_gemini_api_key_here"

# مفتاح التشفير المتناظر للبيانات الحساسة وسجلات المحادثة (Fernet / AES)
# اتركه فارغاً وسيتم إنشاؤه تلقائياً عند أول تشغيل
SECRET_ENCRYPTION_KEY=""

# قائمة المعرفات المسموح لها بالتحدث مع البوت (للحماية من الاستخدام غير المصرح به)
# اتركها "all" للسماح للجميع، أو ضع معرفك مثلاً: ALLOWED_USER_IDS="12345678,87654321"
ALLOWED_USER_IDS="all"
